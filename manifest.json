{
  "manifest_version": 3,
  "name": "Text-Only YouTube",
  "version": "0.1.0",
  "description": "YouTube as a plain text list: no thumbnails, no profile pictures, no Shorts.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["content.css"],
      "js": ["settings.js", "genres.js", "vendor/lucide/lucide.min.js", "content.js", "classify.js"],
      "run_at": "document_start"
    }
  ]
}
